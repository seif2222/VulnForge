{
  "name": "@vulnforge/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VulnForge web dashboard. React + Vite, built into the CLI's assets and served by the local dashboard server. Fully offline: fonts and 3D are bundled.",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist ../cli/assets/dashboard",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vulnforge/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.3.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
